# Copy to .env ON THE HOST (/home/rob/kometa-deploy/.env) and fill in.
# NOT committed — `make kometa-deploy` rsyncs with --exclude='.env'.
#
# NOTE: Kometa's own secrets (Plex token, Radarr/Sonarr/Tautulli API keys,
# Trakt OAuth) do NOT belong here. They live in the host-owned
# ${CONFIG_DIR}/config.yml, which this deploy never overwrites. See README.md.

# Live Kometa config dir — the /config mount. Host-owned.
CONFIG_DIR=/home/rob/docker/volumes/kometa

# Media root — the /data mount.
DATA_DIR=/mnt

# Docker network the container joins (must already exist).
NETWORK=media-net

# Scheduled run times, Kometa's own scheduler.
KOMETA_TIMES=06:00,18:00

# Where the fork's source is checked out on this host.
SRC_DIR=/home/rob/kometa-src

# Fork remote. Public, so no credentials needed.
FORK_URL=https://github.com/raleesound/Kometa.git

# Local image name.
IMAGE=kometa-fork

# Container timezone. REQUIRED: deploy.sh refuses to run without it, because
# KOMETA_TIMES is interpreted in the container's zone (UTC landed a run inside
# Plex's butler window on 2026-09-03).
TZ=America/New_York

# Optional: the BRANCH_NAME label baked into the image for Kometa's update
# check. Does not choose what is built (KOMETA_REF does). Default: nightly.
# BRANCH_NAME=nightly

# Import trigger (trigger/import_trigger.py): published port + debounce.
TRIGGER_PORT=9596
TRIGGER_DEBOUNCE_SECONDS=90
